# Setup database for Jakarta Transactions TCK
# This script configures the Derby datasource for the TCK tests

embed-server --server-config=standalone.xml

# Add Derby JDBC driver
/subsystem=datasources/jdbc-driver=derby:add(driver-name=derby,driver-module-name=org.apache.derby,driver-xa-datasource-class-name=org.apache.derby.jdbc.EmbeddedXADataSource)

# Remove ExampleDS if exists
if (outcome == success) of /subsystem=datasources/data-source=ExampleDS:read-resource
    /subsystem=datasources/data-source=ExampleDS:remove
end-if

# Add ExampleDS datasource pointing to Derby
data-source add --name=ExampleDS --jndi-name=java:jboss/datasources/ExampleDS --driver-name=derby --connection-url=jdbc:derby:${jboss.server.data.dir}/derbyDB;create=true --user-name=cts1 --password=cts1 --use-java-context=true --jta=true --enabled=true

# Add DB1 datasource
data-source add --name=DB1 --jndi-name=java:jboss/datasources/DB1 --driver-name=derby --connection-url=jdbc:derby:${jboss.server.data.dir}/derbyDB;create=true --user-name=cts1 --password=cts1 --use-java-context=true --jta=true --enabled=true

stop-embedded-server