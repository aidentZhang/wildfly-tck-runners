<?xml version="1.0" encoding="UTF-8"?>

<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="appclient" />

    <!-- Container for appclient tests -->
    <container qualifier="tck-appclient" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home:target/wildfly}</property>
            <property name="serverConfig">${server.config:standalone.xml}</property>
            <property name="allowConnectingToRunningServer">true</property>
            <property name="managementAddress">${node0:127.0.0.1}</property>
            <property name="managementPort">${as.managementPort:9990}</property>
        </configuration>
        <protocol type="appclient" default="true">
            <property name="runClient">true</property>
            <property name="runAsVehicle">true</property>
            <property name="clientEarDir">target/appclient</property>
            <property name="unpackClientEar">true</property>
            <property name="clientCmdLineString">java \
                -Dcts.tmp=${ts.home}/tmp \
                -Djavax.net.ssl.keyStore=${ts.home}/bin/certificates/clientcert.jks \
                -Djavax.net.ssl.keyStorePassword=changeit \
                -Djava.naming.factory.initial=org.jboss.wildfly.tck.transactions.AppClientInitialContextFactory \
                -Djava.naming.provider.url=remote+http://localhost:8080 \
                -Dejb.deployment.name=${deploymentName} \
                -cp ${clientEarDir}/${clientAppArchive}:${clientEarDir}/lib/*:${jboss.home}/bin/client/jboss-client.jar:target/classes \
                com.sun.ts.tests.common.vehicle.VehicleClient
            </property>
            <property name="cmdLineArgSeparator">\\</property>
            <property name="clientEnvString">PATH=${env.PATH};APPCPATH=target/test-classes</property>
            <property name="clientDir">${project.basedir}</property>
            <property name="workDir">target</property>
            <property name="tsJteFile">target/ts.jte</property>
            <property name="tsSqlStmtFile">target/sql/derby/derby.dml.sql</property>
            <property name="trace">true</property>
            <property name="clientTimeout">20000</property>
        </protocol>
    </container>

</arquillian>

