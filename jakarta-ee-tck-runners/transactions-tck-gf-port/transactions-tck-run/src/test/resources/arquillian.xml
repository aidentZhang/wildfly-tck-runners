<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://jboss.org/schema/arquillian"
            xsi:schemaLocation="http://jboss.org/schema/arquillian http://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <defaultProtocol type="javatest" />

    <!-- Primary container for tests using @TargetsContainer("tck-javatest") or no annotation -->
    <container qualifier="tck-javatest" default="true">
        <configuration>
            <property name="jbossHome">${jboss.home:target/wildfly}</property>
            <property name="serverConfig">${server.config:standalone.xml}</property>
            <property name="allowConnectingToRunningServer">false</property>
            <property name="managementAddress">${node0:127.0.0.1}</property>
            <property name="managementPort">${as.managementPort:9990}</property>
            <property name="javaVmArguments">-Djboss.bind.address=${node0:127.0.0.1} -Djboss.bind.address.management=${node0:127.0.0.1} -Djboss.bind.address.unsecure=${node0:127.0.0.1}</property>
            <property name="setupCleanServerBaseDir">${wildfly.arquillian.setupCleanServerBaseDir:false}</property>
            <property name="serverStartupCommands">
                /subsystem=datasources/jdbc-driver=derby:add(driver-name=derby,driver-module-name=org.apache.derby,driver-xa-datasource-class-name=org.apache.derby.jdbc.EmbeddedXADataSource)
                data-source add --name=DB1 --jndi-name=java:jboss/datasources/DB1 --driver-name=derby --connection-url=jdbc:derby:memory:derbyDB;create=true --user-name=cts1 --password=cts1 --use-java-context=true --jta=true --enabled=true
            </property>
        </configuration>
        <protocol type="javatest">
            <property name="tsJteFile">target/ts.jte</property>
            <property name="workDir">target</property>
        </protocol>
        <protocol type="appclient">
            <property name="tsJteFile">target/ts.jte</property>
            <property name="workDir">target</property>
        </protocol>
    </container>

    <!-- Secondary container for tests using @TargetsContainer("tck-appclient") -->
    <!-- Standalone container for appclient tests with its own server instance -->
    <container qualifier="tck-appclient">
        <configuration>
            <property name="jbossHome">${jboss.home:target/wildfly}</property>
            <property name="serverConfig">${server.config:standalone.xml}</property>
            <property name="allowConnectingToRunningServer">false</property>
            <property name="managementAddress">${node0:127.0.0.1}</property>
            <property name="managementPort">${as.managementPort:9990}</property>
            <property name="javaVmArguments">-Djboss.bind.address=${node0:127.0.0.1} -Djboss.bind.address.management=${node0:127.0.0.1} -Djboss.bind.address.unsecure=${node0:127.0.0.1}</property>
            <property name="setupCleanServerBaseDir">${wildfly.arquillian.setupCleanServerBaseDir:false}</property>
            <property name="serverStartupCommands">
                /subsystem=datasources/jdbc-driver=derby:add(driver-name=derby,driver-module-name=org.apache.derby,driver-xa-datasource-class-name=org.apache.derby.jdbc.EmbeddedXADataSource)
                data-source add --name=DB1 --jndi-name=java:jboss/datasources/DB1 --driver-name=derby --connection-url=jdbc:derby:memory:derbyDB;create=true --user-name=cts1 --password=cts1 --use-java-context=true --jta=true --enabled=true
            </property>
        </configuration>
        <protocol type="javatest">
            <property name="tsJteFile">target/ts.jte</property>
            <property name="workDir">target</property>
        </protocol>
        <protocol type="appclient">
            <property name="tsJteFile">target/ts.jte</property>
            <property name="workDir">target</property>
        </protocol>
    </container>

</arquillian>

